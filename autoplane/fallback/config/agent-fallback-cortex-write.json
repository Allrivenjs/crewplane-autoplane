    "claude": {
      "enabled": true,
      "prompt_transport": "stdin",
      "output_format": "claude-stream",
      "command": [
        "claude",
        "--model",
        "{model}",
        "-p",
        "--output-format",
        "stream-json",
        "--verbose",
        "--permission-mode",
        "acceptEdits",
        "--permission-prompts",
        "none"
      ],
      "patterns": {
        "quota": [
          "usage limit reached",
          "rate limit reached",
          "quota reached",
          "too many requests",
          "usage limit",
          "rate_limit_error",
          "rate limit"
        ],
        "temporary": [
          "overloaded",
          "temporarily unavailable",
          "service unavailable",
          "try again later"
        ],
        "auth": [
          "not logged in",
          "authentication required",
          "invalid api key",
          "unauthorized"
        ]
      }
    },
    "codex": {
      "enabled": true,
      "prompt_transport": "stdin",
      "output_format": "codex-jsonl",
      "command": [
        "codex",
        "exec",
        "--model",
        "{model}",
        "--json",
        "-c",
        "model_reasoning_effort={effort}",
        "--sandbox",
        "workspace-write",
        "-"
      ],
      "patterns": {
        "quota": [
          "usage limit exceeded",
          "rate limit reached",
          "quota reached",
          "too many requests",
          "hit your usage limit",
          "purchase more credits",
          "rate limit",
          "429"
        ],
        "temporary": [
          "overloaded",
          "temporarily unavailable",
          "service unavailable",
          "try again later"
        ],
        "auth": [
          "not logged in",
          "authentication required",
          "invalid api key",
          "unauthorized"
        ]
      },
      "quota_pool": "codex"
    },
    "antigravity": {
      "enabled": true,
      "prompt_transport": "argument",
      "output_format": "agy-stream",
      "command": [
        "agy",
        "--model",
        "{model}",
        "--mode=accept-edits",
        "--dangerously-skip-permissions",
        "--add-dir",
        "{cwd}",
        "--output-format",
        "stream-json",
        "-p"
      ],
      "patterns": {
        "quota": [
          "resource exhausted",
          "quota exceeded",
          "quota will reset",
          "rate limit reached",
          "resource_exhausted",
          "429",
          "rate limit",
          "quota reached",
          "individual quota"
        ],
        "temporary": [
          "overloaded",
          "temporarily unavailable",
          "service unavailable",
          "try again later"
        ],
        "auth": [
          "not signed in",
          "authentication required",
          "unauthorized",
          "login required"
        ]
      },
      "note": "Escribe sin flags de bypass siempre que el directorio este en trustedWorkspaces de ~/.gemini/antigravity-cli/settings.json. Los worktrees de Crewplane viven bajo /home/allrivenjs/.cache, cubierto por esa lista. --add-dir es obligatorio: sin el, sus herramientas de archivo resuelven contra su propio scratch y reporta SUCCESS sin tocar el worktree.",
      "quota_pool": "antigravity-gemini"
    },
