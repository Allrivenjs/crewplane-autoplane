    "antigravity": {
      "enabled": true,
      "prompt_transport": "argument",
      "output_format": "agy-stream",
      "command": [
        "agy",
        "--model",
        "{model}",
        "--mode=plan",
        "--add-dir",
        "{cwd}",
        "--output-format",
        "stream-json",
        "-p"
      ],
      "patterns": {
        "quota": [
          "resource exhausted",
          "quota exceeded",
          "quota will reset",
          "rate limit reached",
          "resource_exhausted",
          "429",
          "rate limit",
          "quota reached",
          "individual quota"
