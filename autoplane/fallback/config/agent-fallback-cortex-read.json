    "thinker": [
      "claude",
      "codex",
      "ali-dspro",
      "opencode-go"
    ],
    "reviewer": [
      "codex",
      "claude",
      "claude-sonnet",
      "ali-dspro",
      "opencode-go"
    ]
  },
  "log_path": "/mnt/ssd500/projects/personal/cortex/crewplane-multi-agent-sandbox/.agent/logs/cortex.jsonl",
  "providers": {
    "claude": {
      "enabled": true,
      "prompt_transport": "stdin",
      "output_format": "claude-stream",
      "command": [
        "claude",
        "--model",
        "{model}",
        "-p",
        "--output-format",
        "stream-json",
        "--verbose",
        "--permission-mode",
        "plan",
        "--permission-prompts",
        "none"
      ],
      "patterns": {
        "quota": [
          "usage limit reached",
          "rate limit reached",
          "quota reached",
          "too many requests",
          "usage limit",
          "rate_limit_error",
          "rate limit"
        ],
        "temporary": [
          "overloaded",
          "temporarily unavailable",
          "service unavailable",
          "try again later"
        ],
        "auth": [
          "not logged in",
          "authentication required",
          "invalid api key",
          "unauthorized"
        ]
      },
      "quota_pool": "claude"
    },
    "codex": {
      "enabled": true,
      "prompt_transport": "stdin",
      "output_format": "codex-jsonl",
      "command": [
        "codex",
        "exec",
        "--model",
        "{model}",
        "--json",
        "-c",
        "model_reasoning_effort={effort}",
        "--sandbox",
        "read-only",
        "-"
