      "enabled": true,
      "prompt_transport": "argument",
      "output_format": "opencode-json",
      "quota_pool": "opencode-go/kimi-k3",
      "command": [
        "env",
        "OPENCODE_CONFIG=/mnt/ssd500/projects/personal/cortex/crewplane-multi-agent-sandbox/config/opencode-readonly.json",
        "opencode",
        "run",
        "--format",
        "json",
        "--auto",
        "--model",
        "{model}"
      ],
      "note": "Plan OpenCode Go (opencode-go/<modelo>): requiere conectar la API key de Go con `opencode auth login`; hasta entonces responde «Model unavailable» y se enfria. Solo lectura: edit denegado.",
      "patterns": {
        "quota": [
          "provider.quota",
          "insufficient account funds",
          "insufficient credits",
          "rate limit",
          "429",
          "402",
          "quota"
        ],
        "temporary": [
          "overloaded",
          "temporarily unavailable",
          "service unavailable",
          "503",
          "timeout",
          "econnreset"
        ],
        "auth": [
          "model unavailable",
          "provider.no-route",
          "unauthorized",
          "401",
          "invalid api key",
          "provider.auth",
          "only available hosted"
        ]
      }
    },
